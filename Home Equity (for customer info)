public class HomeEquity {

    private double homeValue;
    private double loanAmount;

    public HomeEquity(double homeValue, double loanAmount) {
        this.homeValue = homeValue;
        this.loanAmount = loanAmount;
    }

    public void display() {
        System.out.println("Home Value: $" + homeValue);
        System.out.println("Home Equity Loan: $" + loanAmount);
    }
}

